{
    "name": "@perspective-dev/viewer-plotly",
    "version": "4.3.0",
    "description": "Perspective.js Plotly Plugin",
    "unpkg": "./dist/cdn/perspective-viewer-plotly.js",
    "jsdelivr": "./dist/cdn/perspective-viewer-plotly.js",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/perspective-viewer-plotly.js"
        },
        "./src/*": "./src/*",
        "./dist/*": "./dist/*",
        "./cdn/": "./dist/cdn/",
        "./esm/": "./dist/esm/",
        "./bar": "./dist/esm/bar.js",
        "./line": "./dist/esm/line.js",
        "./scatter": "./dist/esm/scatter.js",
        "./pie": "./dist/esm/pie.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "index.d.ts"
    ],
    "types": "dist/esm/index.d.ts",
    "scripts": {
        "build": "node ./build.mjs",
        "clean": "node ./clean.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/perspective-dev/perspective"
    },
    "author": "",
    "license": "Apache-2.0",
    "dependencies": {
        "@perspective-dev/client": "workspace:",
        "@perspective-dev/viewer": "workspace:",
        "plotly.js-basic-dist-min": "catalog:"
    },
    "devDependencies": {
        "@perspective-dev/esbuild-plugin": "workspace:",
        "@prospective.co/procss": "catalog:",
        "@types/plotly.js": "catalog:",
        "typescript": "catalog:"
    }
}
